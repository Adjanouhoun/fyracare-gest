# Valeurs de développement sans secret.
# Les valeurs réelles doivent être placées dans .env.local, qui n'est pas suivi par Git.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-in-env-local
DEFAULT_URI=http://localhost
MAILER_DSN=null://null
DATABASE_URL="sqlite:///%kernel.project_dir%/var/dev/fyracare-dev.sqlite"

APP_INACTIVITY_SECONDS=900
APP_INACTIVITY_WARNING=60
APP_INACTIVITY_ENABLED=true
APP_INACTIVITY_LOGOUT_MODE=false
