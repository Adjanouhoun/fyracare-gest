{% extends 'layouts/main.html.twig' %}

{% block title %}Encaisser un paiement{% endblock %}

{% block stylesheets %}
  <style>
    .payment-hero { background: linear-gradient(135deg, #174a7e, #276da7); color: #fff; }
    .payment-kpi { border-right: 1px solid rgba(255,255,255,.22); }
    .payment-kpi:last-child { border-right: 0; }
    .payment-method { cursor: pointer; border: 2px solid #e5e9f0; border-radius: .65rem; transition: .15s ease; }
    .payment-method:hover { border-color: #9cbde0; transform: translateY(-1px); }
    .payment-method:has(input:checked) { border-color: #299cdb; background: #eef7fd; box-shadow: 0 0 0 3px rgba(41,156,219,.1); }
    .payment-method input { position: absolute; opacity: 0; pointer-events: none; }
    .payment-amount { font-size: 1.7rem; font-weight: 700; }
    .payment-shortcut.active { color: #fff; background: #299cdb; border-color: #299cdb; }
    .payment-review { background: #f5f8fb; border: 1px solid #dce5ee; }
    .payment-safety { border-left: 4px solid #299cdb; }
    .note-preset { border-style: dashed; }
    .note-preset:hover { border-style: solid; }
    @media (max-width: 767.98px) {
      .payment-kpi { border-right: 0; border-bottom: 1px solid rgba(255,255,255,.18); }
      .payment-kpi:last-child { border-bottom: 0; }
    }
  </style>
{% endblock %}

{% block page_header %}
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
    <div>
      <h4 class="fs-16 mb-1"><i class="ri-secure-payment-line me-1"></i> Encaisser un paiement</h4>
      <p class="text-muted mb-0">Vérifiez le dossier, choisissez le montant et confirmez le mode d’encaissement.</p>
    </div>
    <a class="btn btn-soft-secondary" href="{{ path('app_rdv_show', {id: rdv.id}) }}">
      <i class="ri-arrow-left-line me-1"></i> Retour au rendez-vous
    </a>
  </div>
{% endblock %}

{% block body %}
  {% include 'partials/flashes.html.twig' %}

  <div class="card payment-hero border-0">
    <div class="card-body p-4">
      <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div>
          <div class="text-white-50 text-uppercase fs-12 mb-1">Dossier à encaisser</div>
          <h3 class="text-white mb-1">{{ rdv.client.nometprenom }}</h3>
          <div class="text-white-50">
            {{ rdv.prestation.libelle }} · {{ rdv.startAt|date('d/m/Y à H:i') }}
          </div>
        </div>
        <span class="badge bg-white text-primary fs-13">RDV n° {{ rdv.id }}</span>
      </div>
      <div class="row g-0">
        <div class="col-md-4 payment-kpi py-2 pe-md-4">
          <div class="text-white-50 fs-12 text-uppercase">Prix total</div>
          <div class="fs-4 fw-semibold">{{ rdv.totalAmount|number_format(0, ',', ' ') }} <small>MRU</small></div>
        </div>
        <div class="col-md-4 payment-kpi py-2 px-md-4">
          <div class="text-white-50 fs-12 text-uppercase">Déjà encaissé</div>
          <div class="fs-4 fw-semibold">{{ rdv.totalPaid|number_format(0, ',', ' ') }} <small>MRU</small></div>
        </div>
        <div class="col-md-4 payment-kpi py-2 ps-md-4">
          <div class="text-white-50 fs-12 text-uppercase">Reste à payer</div>
          <div class="fs-3 fw-bold">{{ rdv.remainingAmount|number_format(0, ',', ' ') }} <small>MRU</small></div>
        </div>
      </div>
    </div>
  </div>

  {{ form_start(form, {attr: {id: 'payment-form', novalidate: 'novalidate'}}) }}
  <div class="row g-4">
    <div class="col-xl-7">
      <div class="card h-100">
        <div class="card-header">
          <h5 class="card-title mb-1">1. Montant du versement</h5>
          <p class="text-muted mb-0">Le paiement complet est proposé par défaut. Vous pouvez saisir un acompte libre.</p>
        </div>
        <div class="card-body">
          <label class="form-label" for="{{ form.amount.vars.id }}">Montant à encaisser <span class="text-danger">*</span></label>
          <div class="input-group input-group-lg mb-2">
            <span class="input-group-text"><i class="ri-money-dollar-circle-line"></i></span>
            {{ form_widget(form.amount, {
              attr: {
                class: 'form-control payment-amount',
                min: 1,
                max: rdv.remainingAmount,
                step: 1,
                inputmode: 'numeric',
                autocomplete: 'off'
              }
            }) }}
            <span class="input-group-text fw-semibold">MRU</span>
          </div>
          {{ form_errors(form.amount) }}
          <div id="amount-feedback" class="alert alert-success py-2 mb-3" aria-live="polite"></div>

          <div class="d-flex flex-wrap gap-2 mb-4" aria-label="Montants rapides">
            {% for percentage in [25, 50, 75] %}
              {% set shortcutAmount = (rdv.remainingAmount * percentage / 100)|round(0, 'common') %}
              <button type="button" class="btn btn-outline-primary payment-shortcut" data-amount="{{ shortcutAmount }}">
                {{ percentage }} % · {{ shortcutAmount|number_format(0, ',', ' ') }}
              </button>
            {% endfor %}
            <button type="button" class="btn btn-outline-primary payment-shortcut active" data-amount="{{ rdv.remainingAmount }}">
              Solde complet · {{ rdv.remainingAmount|number_format(0, ',', ' ') }}
            </button>
          </div>

          <h5 class="mb-3">2. Mode d’encaissement</h5>
          <div class="row g-3">
            {% for choice in form.methode %}
              {% set isCash = choice.vars.value == 'ESPECES' %}
              <div class="col-md-6">
                <label class="payment-method d-block h-100 p-3" for="{{ choice.vars.id }}">
                  {{ form_widget(choice) }}
                  <div class="d-flex align-items-start gap-3">
                    <span class="avatar-sm flex-shrink-0">
                      <span class="avatar-title rounded-circle {{ isCash ? 'bg-success-subtle text-success' : 'bg-info-subtle text-info' }}">
                        <i class="{{ isCash ? 'ri-wallet-3-line' : 'ri-smartphone-line' }} fs-4"></i>
                      </span>
                    </span>
                    <div>
                      <strong class="d-block fs-15">{{ choice.vars.label }}</strong>
                      <small class="text-muted">
                        {{ isCash
                          ? 'Entre dans le solde physique de la caisse.'
                          : 'Enregistré comme recette, hors caisse physique.' }}
                      </small>
                    </div>
                  </div>
                </label>
              </div>
            {% endfor %}
          </div>
          {{ form_errors(form.methode) }}

          <div id="method-warning" class="alert alert-info payment-safety mt-3 mb-0">
            <strong>Espèces :</strong> ce montant augmentera le solde théorique physique de la caisse.
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-5">
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="card-title mb-0">3. Vérification finale</h5>
        </div>
        <div class="card-body">
          <div class="payment-review rounded p-3 mb-3">
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">Client</span><strong class="text-end">{{ rdv.client.nometprenom }}</strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">Montant</span><strong id="review-amount" class="text-primary">{{ rdv.remainingAmount|number_format(0, ',', ' ') }} MRU</strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">Mode</span><strong id="review-method">Espèces</strong>
            </div>
            <div class="d-flex justify-content-between">
              <span class="text-muted">Après paiement</span><strong id="review-balance">Soldé</strong>
            </div>
          </div>

          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <label class="form-label mb-0" for="{{ form.notes.vars.id }}">
              Note de traçabilité <span class="text-muted">(facultatif)</span>
            </label>
            <span class="badge bg-light text-muted"><i class="ri-lock-line me-1"></i>Usage interne</span>
          </div>
          <p id="note-help" class="small text-muted mt-1 mb-2">
            Ajoutez uniquement une information utile au contrôle du paiement.
          </p>
          <div class="d-flex flex-wrap gap-1 mb-2" aria-label="Suggestions de note">
            <button type="button" class="btn btn-sm btn-soft-secondary note-preset" data-note="Paiement reçu sans incident.">Reçu sans incident</button>
            <button type="button" class="btn btn-sm btn-soft-secondary note-preset" data-note="Acompte convenu avec le client.">Acompte convenu</button>
            <button type="button" class="btn btn-sm btn-soft-info note-preset" data-note="Référence mobile : " data-mobile-only>Référence mobile</button>
          </div>
          {{ form_widget(form.notes, {
            attr: {
              rows: 4,
              maxlength: 500,
              placeholder: 'Ex. référence de transaction ou précision nécessaire au contrôle…',
              'aria-describedby': 'note-help note-counter'
            }
          }) }}
          <div class="d-flex justify-content-between mt-1">
            <small class="text-muted"><i class="ri-shield-user-line me-1"></i>Ne saisissez ni mot de passe, ni code secret, ni donnée médicale.</small>
            <small id="note-counter" class="text-muted">0 / 500</small>
          </div>
          {{ form_errors(form.notes) }}

          <div class="d-none">{{ form_row(form.paidAt) }}</div>
          {{ form_rest(form) }}

          <div class="alert alert-warning mt-3 mb-3">
            <i class="ri-error-warning-line me-1"></i>
            Vérifiez le montant et le mode : après validation, toute correction devra être tracée par une annulation comptable.
          </div>
          <button type="submit" id="submit-payment-btn" class="btn btn-success btn-lg w-100">
            <i class="ri-shield-check-line me-1"></i>
            Confirmer l’encaissement
          </button>
          <a href="{{ path('app_rdv_show', {id: rdv.id}) }}" class="btn btn-link text-muted w-100 mt-2">Abandonner sans enregistrer</a>
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <h6 class="mb-3"><i class="ri-file-list-3-line me-1"></i> Rendez-vous vérifié</h6>
          <div class="d-flex justify-content-between mb-2"><span class="text-muted">Téléphone</span><span>{{ rdv.client.telephone ?: 'Non renseigné' }}</span></div>
          <div class="d-flex justify-content-between mb-2"><span class="text-muted">Début</span><span>{{ rdv.startAt|date('d/m/Y H:i') }}</span></div>
          <div class="d-flex justify-content-between mb-2"><span class="text-muted">Fin</span><span>{{ rdv.endAt|date('d/m/Y H:i') }}</span></div>
          <div class="d-flex justify-content-between"><span class="text-muted">Statut</span><span class="badge bg-light text-dark">{{ rdv.status }}</span></div>
        </div>
      </div>
    </div>
  </div>
  {{ form_end(form) }}

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const remaining = {{ rdv.remainingAmount }};
      const amountInput = document.getElementById('{{ form.amount.vars.id }}');
      const feedback = document.getElementById('amount-feedback');
      const reviewAmount = document.getElementById('review-amount');
      const reviewMethod = document.getElementById('review-method');
      const reviewBalance = document.getElementById('review-balance');
      const methodWarning = document.getElementById('method-warning');
      const submitButton = document.getElementById('submit-payment-btn');
      const shortcuts = document.querySelectorAll('.payment-shortcut');
      const methods = document.querySelectorAll('input[name="{{ form.methode.vars.full_name }}"]');
      const formElement = document.getElementById('payment-form');
      const notesInput = document.getElementById('{{ form.notes.vars.id }}');
      const noteCounter = document.getElementById('note-counter');
      const notePresets = document.querySelectorAll('.note-preset');
      const mobileNotePreset = document.querySelector('[data-mobile-only]');

      function formatAmount(value) {
        return Math.max(0, Number(value) || 0).toLocaleString('fr-FR');
      }

      function updateSummary() {
        const amount = Number.parseInt(amountInput.value, 10) || 0;
        const balance = remaining - amount;
        const valid = amount > 0 && amount <= remaining;

        reviewAmount.textContent = formatAmount(amount) + ' MRU';
        submitButton.disabled = !valid;

        shortcuts.forEach(function (button) {
          button.classList.toggle('active', Number(button.dataset.amount) === amount);
        });

        if (amount <= 0) {
          feedback.className = 'alert alert-danger py-2 mb-3';
          feedback.textContent = 'Saisissez un montant strictement positif.';
          reviewBalance.textContent = 'Montant invalide';
          reviewBalance.className = 'text-danger';
        } else if (amount > remaining) {
          feedback.className = 'alert alert-danger py-2 mb-3';
          feedback.textContent = 'Le montant dépasse le reste à payer de ' + formatAmount(remaining) + ' MRU.';
          reviewBalance.textContent = 'Dépassement interdit';
          reviewBalance.className = 'text-danger';
        } else if (balance === 0) {
          feedback.className = 'alert alert-success py-2 mb-3';
          feedback.textContent = 'Paiement final : le rendez-vous sera entièrement soldé.';
          reviewBalance.textContent = 'Soldé';
          reviewBalance.className = 'text-success';
        } else {
          feedback.className = 'alert alert-warning py-2 mb-3';
          feedback.textContent = 'Acompte : il restera ' + formatAmount(balance) + ' MRU à payer.';
          reviewBalance.textContent = formatAmount(balance) + ' MRU restant';
          reviewBalance.className = 'text-warning';
        }
      }

      function updateMethod() {
        const selected = document.querySelector('input[name="{{ form.methode.vars.full_name }}"]:checked');
        const mobile = selected && selected.value === 'MOBILE';
        reviewMethod.textContent = mobile ? 'Mobile' : 'Espèces';
        methodWarning.className = 'alert payment-safety mt-3 mb-0 ' + (mobile ? 'alert-info' : 'alert-success');
        methodWarning.innerHTML = mobile
          ? '<strong>Mobile :</strong> recette informative hors solde physique. Vérifiez la confirmation sur le terminal du client.'
          : '<strong>Espèces :</strong> ce montant augmentera le solde théorique physique de la caisse.';
        mobileNotePreset.classList.toggle('d-none', !mobile);
        notesInput.placeholder = mobile
          ? 'Ex. référence de transaction mobile ou précision nécessaire au contrôle…'
          : 'Ex. précision utile sur la remise d’espèces…';
      }

      function updateNoteCounter() {
        const length = notesInput.value.length;
        noteCounter.textContent = length + ' / 500';
        noteCounter.className = length >= 450 ? 'text-warning fw-semibold' : 'text-muted';
      }

      shortcuts.forEach(function (button) {
        button.addEventListener('click', function () {
          amountInput.value = button.dataset.amount;
          updateSummary();
          amountInput.focus();
        });
      });
      amountInput.addEventListener('input', updateSummary);
      methods.forEach(function (method) { method.addEventListener('change', updateMethod); });
      notePresets.forEach(function (button) {
        button.addEventListener('click', function () {
          const addition = button.dataset.note;
          const separator = notesInput.value.trim() === '' ? '' : '\n';
          notesInput.value = (notesInput.value + separator + addition).slice(0, 500);
          updateNoteCounter();
          notesInput.focus();
          notesInput.setSelectionRange(notesInput.value.length, notesInput.value.length);
        });
      });
      notesInput.addEventListener('input', updateNoteCounter);

      formElement.addEventListener('submit', function (event) {
        const amount = Number.parseInt(amountInput.value, 10) || 0;
        if (amount <= 0 || amount > remaining) {
          event.preventDefault();
          updateSummary();
          amountInput.focus();
          return;
        }
        submitButton.disabled = true;
        submitButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> Enregistrement…';
      });

      updateSummary();
      updateMethod();
      updateNoteCounter();
    });
  </script>
{% endblock %}
