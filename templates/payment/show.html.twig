{% extends 'layouts/main.html.twig' %}
{% block title %}Paiement #{{ payment.id }}{% endblock %}

{% block page_header %}
	<div class="row">
		<div class="col-12">
			<div class="page-title-box d-sm-flex align-items-center justify-content-between">
				<div>
					<h4 class="mb-sm-0">
						<i class="ri-cash-line"></i>
						Gestion des paiements
					</h4>
					<p class="text-muted mb-0">Voir - Imprimer reçu</p>
				</div>
				<div class="page-title-right">
					<ol class="breadcrumb m-0">
						<li class="breadcrumb-item">
							<a href="{{ path('admin_dashboard') }}">Tableau de bord</a>
						</li>
						<li class="breadcrumb-item active">Paiements</li>
					</ol>
				</div>
			</div>
		</div>
	</div>
	<div class="card">
		<div class="card-body">
			<div class="row mb-3 pb-1">
				<div class="d-flex align-items-center justify-content-between">
					<div>
						<h4 class="fs-16 mb-1">Détail du paiement</h4>
						<p class="text-muted mb-0">Reçu :
							{{ payment.receiptNumber }}</p>
					</div>
					<div>
						<a href="{{ path('app_payment_receipt', {id: payment.id}) }}" target="_blank" class="btn btn-primary">
							<i class="ri-printer-line"></i>
							Reçu
						</a>
						{% if shareLinks.whatsapp %}
							<a href="{{ shareLinks.whatsapp }}" target="_blank" rel="noopener noreferrer" class="btn btn-success">
								<i class="ri-whatsapp-line"></i> WhatsApp
							</a>
						{% else %}
							<button type="button" class="btn btn-light" disabled title="Téléphone client indisponible">
								<i class="ri-whatsapp-line"></i> WhatsApp
							</button>
						{% endif %}
						{% if shareLinks.email %}
							<a href="{{ shareLinks.email }}" class="btn btn-info">
								<i class="ri-mail-send-line"></i> E-mail
							</a>
						{% else %}
							<button type="button" class="btn btn-light" disabled title="E-mail client indisponible">
								<i class="ri-mail-send-line"></i> E-mail
							</button>
						{% endif %}
						<a href="{{ path('app_payment_index') }}" class="btn btn-ghost-secondary">Retour</a>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block body %}
	<div class="alert alert-info d-flex align-items-start">
		<i class="ri-information-line fs-4 me-2"></i>
		<div><strong>Partage assisté :</strong> WhatsApp ou votre logiciel de messagerie s’ouvre avec un texte prérempli. Vérifiez le destinataire et le message avant l’envoi. Pour joindre le reçu, téléchargez d’abord le PDF depuis le bouton <strong>Reçu</strong>.</div>
	</div>
	{% if payment.cancelled %}
		<div class="alert alert-danger">
			<strong>Paiement annulé le {{ payment.cancelledAt|date('d/m/Y H:i') }}</strong>
			{% if payment.cancelledBy %} par {{ payment.cancelledBy.fullname }}{% endif %}.<br>
			<strong>Motif :</strong> {{ payment.cancellationReason }}<br>
			Une contrepassation du même montant a été enregistrée en caisse.
		</div>
	{% endif %}
	<div class="card">
		<div class="card-body">
			<div class="row g-3">
				<div class="col-md-4">
					<strong>Date :</strong>
					{{ payment.paidAt|date('d/m/Y H:i') }}</div>
				<div class="col-md-4">
					<strong>Méthode :</strong>
					{{ payment.methode }}</div>
				<div class="col-md-4">
					<strong>Montant :</strong>
					{{ payment.amount|number_format(0, ',', ' ') }}
					MRU</div>
				<div class="col-md-4">
					<strong>Encaissé par :</strong>
					{{ payment.receivedBy ? payment.receivedBy.fullname : 'Information historique indisponible' }}</div>
				<div class="col-md-4">
					<strong>Client :</strong>
					{{ rdv.client.nometprenom }}
					({{ rdv.client.telephone }})</div>
				<div class="col-md-4">
					<strong>Prestation :</strong>
					{{ rdv.prestation.libelle }}</div>
				<div class="col-md-4">
					<strong>Début :</strong>
					{{ rdv.startAt|date('d/m/Y H:i') }}</div>
				<div class="col-md-4">
					<strong>Fin :</strong>
					{{ rdv.endAt|date('d/m/Y H:i') }}</div>
				{% if payment.notes %}
					<div class="col-12">
						<strong>Notes :</strong><br>{{ payment.notes }}</div>
				{% endif %}
			</div>
		</div>
	</div>
	{% if is_granted('ROLE_ADMIN') and not payment.cancelled %}
		<div class="card border-danger">
			<div class="card-header"><strong>Annulation comptable</strong></div>
			<div class="card-body">{{ include('payment/_delete_form.html.twig') }}</div>
		</div>
	{% endif %}
{% endblock %}
