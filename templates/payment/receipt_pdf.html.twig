<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  {% set shortReference = 'REC-' ~ payment.paidAt|date('Y') ~ '-' ~ '%06d'|format(payment.id) %}
  {% set methodLabel = payment.methode == constant('App\\Entity\\Payment::M_MOBILE') ? 'Paiement mobile' : 'Espèces' %}
  <title>Reçu {{ shortReference }}</title>
  <style>
    @page { size: A5 portrait; margin: 11mm; }
    * { box-sizing: border-box; }
    body { margin: 0; color: #27313c; font-family: "DejaVu Sans", Arial, sans-serif; font-size: 9px; line-height: 1.45; }
    table { width: 100%; border-collapse: collapse; }
    td { vertical-align: top; }
    .header { border-bottom: 1px solid #dce3ea; padding-bottom: 13px; }
    .logo { width: 64px; height: 64px; object-fit: contain; vertical-align: middle; }
    .brand { display: inline-block; vertical-align: middle; margin-left: 10px; }
    .brand h1 { margin: 0 0 2px; font-size: 18px; color: #1f2933; }
    .muted { color: #718096; }
    .small { font-size: 7.5px; }
    .right { text-align: right; }
    .label { color: #718096; font-size: 7px; font-weight: bold; letter-spacing: .7px; text-transform: uppercase; }
    .receipt-title { margin: 1px 0; font-size: 15px; color: #1f2933; }
    .method { display: inline-block; margin-top: 5px; padding: 3px 8px; border: 1px solid #dce3ea; border-radius: 10px; }
    .party { padding: 16px 0 13px; }
    .party h2 { margin: 4px 0 2px; font-size: 12px; color: #1f2933; }
    .amount { background: #196aa6; color: #fff; border-radius: 8px; padding: 15px 17px; }
    .amount-label { color: #d6e9f8; font-size: 8px; font-weight: bold; text-transform: uppercase; }
    .amount-value { margin-top: 4px; font-size: 26px; font-weight: bold; line-height: 1; }
    .amount-type { text-align: right; vertical-align: middle; }
    .amount-type span { display: inline-block; background: #fff; color: #196aa6; padding: 4px 9px; border-radius: 10px; font-weight: bold; }
    .summary { margin-top: 14px; background: #f5f7fa; border-radius: 7px; padding: 10px 13px; }
    .summary-lines td { padding: 4px 0; border-bottom: 1px solid #e2e7ed; }
    .summary-lines tr:last-child td { border-bottom: 0; }
    .summary-value { width: 38%; text-align: right; white-space: nowrap; }
    .status { width: 32%; text-align: center; vertical-align: middle; padding-left: 15px !important; }
    .status-badge { display: inline-block; padding: 6px 9px; border-radius: 12px; font-weight: bold; }
    .success { color: #16794b; background: #e3f7ed; }
    .warning { color: #946200; background: #fff3d6; }
    .danger { color: #a62929; background: #fde7e7; }
    .cancelled { margin-bottom: 10px; padding: 8px; text-align: center; color: #a62929; background: #fde7e7; border: 1px solid #f2bcbc; font-weight: bold; }
    .note { margin-top: 12px; padding: 8px 10px; border: 1px solid #dce3ea; border-radius: 5px; }
    .footer { margin-top: 16px; padding-top: 10px; border-top: 1px solid #dce3ea; }
    .technical { font-size: 6.5px; color: #8a96a3; word-break: break-all; }
  </style>
</head>
<body>
  {% if payment.cancelled %}<div class="cancelled">PAIEMENT ANNULÉ — document conservé pour la traçabilité</div>{% endif %}

  <table class="header">
    <tr>
      <td style="width:62%">
        {% if logoDataUri %}<img class="logo" src="{{ logoDataUri }}" alt="Logo">{% endif %}
        <div class="brand">
          <h1>Fyracare</h1>
          {% if settings.address %}<div class="muted">{{ settings.address }}</div>{% endif %}
          <div class="muted small">
            {% if settings.phone %}Tél. {{ settings.phone }}{% endif %}
            {% if settings.email %} · {{ settings.email }}{% endif %}
          </div>
        </div>
      </td>
      <td class="right" style="width:38%">
        <div class="label">Reçu de paiement</div>
        <div class="receipt-title">{{ shortReference }}</div>
        <div class="muted">{{ payment.paidAt|date('d/m/Y à H:i') }}</div>
        <div class="method">{{ methodLabel }}</div>
      </td>
    </tr>
  </table>

  <table class="party">
    <tr>
      <td style="width:50%">
        <div class="label">Client</div>
        <h2>{{ payment.rdv.client.nometprenom }}</h2>
        {% if payment.rdv.client.telephone %}<div class="muted">{{ payment.rdv.client.telephone }}</div>{% endif %}
        {% if payment.rdv.client.email %}<div class="muted">{{ payment.rdv.client.email }}</div>{% endif %}
      </td>
      <td class="right" style="width:50%">
        <div class="label">Prestation</div>
        <h2>{{ payment.rdv.prestation.libelle }}</h2>
        <div class="muted">Rendez-vous du {{ payment.rdv.startAt|date('d/m/Y') }}</div>
        <div class="muted">{{ payment.rdv.startAt|date('H:i') }} – {{ payment.rdv.endAt|date('H:i') }}</div>
      </td>
    </tr>
  </table>

  <div class="amount">
    <table><tr>
      <td>
        <div class="amount-label">Montant versé</div>
        <div class="amount-value">{{ payment.amount|number_format(0, ',', ' ') }} <span style="font-size:10px;font-weight:normal">MRU</span></div>
      </td>
      <td class="amount-type"><span>{{ payment.isDeposit ? 'Acompte' : 'Paiement final' }}</span></td>
    </tr></table>
  </div>

  <div class="summary">
    <table>
      <tr>
        <td style="width:68%">
          <table class="summary-lines">
            <tr><td class="muted">Prix total de la prestation</td><td class="summary-value"><strong>{{ payment.rdv.totalAmount|number_format(0, ',', ' ') }} MRU</strong></td></tr>
            <tr><td class="muted">Total payé sur ce rendez-vous</td><td class="summary-value"><strong>{{ payment.rdv.totalPaid|number_format(0, ',', ' ') }} MRU</strong></td></tr>
            <tr><td class="muted">Reste à payer</td><td class="summary-value"><strong>{{ payment.rdv.remainingAmount|number_format(0, ',', ' ') }} MRU</strong></td></tr>
          </table>
        </td>
        <td class="status">
          {% if payment.cancelled %}
            <span class="status-badge danger">Paiement annulé</span>
          {% elseif payment.rdv.remainingAmount <= 0 %}
            <span class="status-badge success">Payé intégralement</span>
          {% else %}
            <span class="status-badge warning">Paiement partiel</span>
          {% endif %}
        </td>
      </tr>
    </table>
  </div>

  {% if payment.notes %}<div class="note"><div class="label">Note de paiement</div><div>{{ payment.notes }}</div></div>{% endif %}

  <table class="footer">
    <tr>
      <td style="width:55%">
        <strong>Merci pour votre confiance.</strong>
        <div class="muted small">Encaissement enregistré par {{ payment.receivedBy ? payment.receivedBy.fullname : 'utilisateur historique non identifié' }}.</div>
      </td>
      <td class="right" style="width:45%">
        <div class="label">Référence technique</div>
        <div class="technical">{{ payment.receiptNumber }}</div>
      </td>
    </tr>
  </table>
</body>
</html>
