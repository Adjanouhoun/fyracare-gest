{% extends 'layouts/main.html.twig' %}
{% block title %}Classement des clients{% endblock %}

{% block page_header %}
  <div class="row">
    <div class="col-12">
      <div class="page-title-box d-sm-flex align-items-center justify-content-between">
        <div>
          <h4 class="mb-sm-0"><i class="ri-trophy-line me-2 text-warning"></i>Classement des clients</h4>
          <p class="text-muted mb-0">Passages honorés et montants réellement encaissés</p>
        </div>
        <ol class="breadcrumb m-0">
          <li class="breadcrumb-item"><a href="{{ path('app_client_index') }}">Clients</a></li>
          <li class="breadcrumb-item active">Classement</li>
        </ol>
      </div>
    </div>
  </div>
{% endblock %}

{% block body %}
  <div class="card mb-4">
    <div class="card-body">
      <form method="get" class="row g-3 align-items-end">
        <div class="col-lg-3 col-md-6">
          <label class="form-label" for="ranking-search">Client</label>
          <input id="ranking-search" class="form-control" type="search" name="q" value="{{ q }}" placeholder="Nom, téléphone ou email">
        </div>
        <div class="col-lg-2 col-md-3">
          <label class="form-label" for="ranking-from">Du</label>
          <input id="ranking-from" class="form-control" type="date" name="from" value="{{ from }}">
        </div>
        <div class="col-lg-2 col-md-3">
          <label class="form-label" for="ranking-to">Au</label>
          <input id="ranking-to" class="form-control" type="date" name="to" value="{{ to }}">
        </div>
        <div class="col-lg-2 col-md-4">
          <label class="form-label" for="ranking-sort">Classer par</label>
          <select id="ranking-sort" class="form-select" name="sort">
            <option value="spent" {{ sort == 'spent' ? 'selected' : '' }}>Total dépensé</option>
            <option value="visits" {{ sort == 'visits' ? 'selected' : '' }}>Nombre de passages</option>
            <option value="average" {{ sort == 'average' ? 'selected' : '' }}>Panier moyen</option>
            <option value="recent" {{ sort == 'recent' ? 'selected' : '' }}>Dernier passage</option>
          </select>
        </div>
        <div class="col-lg-1 col-md-4">
          <label class="form-label" for="ranking-min-visits">Passages min.</label>
          <input id="ranking-min-visits" class="form-control" type="number" min="0" name="minVisits" value="{{ minVisits }}">
        </div>
        <div class="col-lg-2 col-md-4 d-flex gap-2">
          <button class="btn btn-primary flex-grow-1" type="submit"><i class="ri-filter-3-line me-1"></i>Filtrer</button>
          <a class="btn btn-light" href="{{ path('app_client_ranking') }}" title="Réinitialiser"><i class="ri-refresh-line"></i></a>
        </div>
      </form>
      <div class="form-text mt-3">
        Sans période, le classement couvre tout l’historique. Un passage correspond uniquement à un rendez-vous honoré ; les paiements annulés sont exclus.
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted text-uppercase fs-12 fw-semibold">Clients avec activité</div>
        <div class="fs-2 fw-bold mt-2">{{ activeClients }}</div>
      </div></div>
    </div>
    <div class="col-xl-3 col-md-6">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted text-uppercase fs-12 fw-semibold">Total encaissé</div>
        <div class="fs-2 fw-bold text-success mt-2">{{ totalSpent|number_format(0, ',', ' ') }} <small class="fs-6">MRU</small></div>
      </div></div>
    </div>
    <div class="col-xl-3 col-md-6">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted text-uppercase fs-12 fw-semibold">Plus forte dépense</div>
        {% if topBySpent %}
          <div class="fw-bold mt-2">{{ topBySpent.client.nometprenom }}</div>
          <div class="text-success">{{ topBySpent.totalSpent|number_format(0, ',', ' ') }} MRU</div>
        {% else %}<div class="text-muted mt-2">Aucune donnée</div>{% endif %}
      </div></div>
    </div>
    <div class="col-xl-3 col-md-6">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted text-uppercase fs-12 fw-semibold">Plus de passages</div>
        {% if topByVisits %}
          <div class="fw-bold mt-2">{{ topByVisits.client.nometprenom }}</div>
          <div class="text-primary">{{ topByVisits.visits }} passage{{ topByVisits.visits > 1 ? 's' : '' }}</div>
        {% else %}<div class="text-muted mt-2">Aucune donnée</div>{% endif %}
      </div></div>
    </div>
  </div>

  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <div>
        <h5 class="card-title mb-1">Résultats du classement</h5>
        <p class="text-muted mb-0">Le rang suit le critère sélectionné.</p>
      </div>
      <a class="btn btn-soft-secondary btn-sm" href="{{ path('app_client_index') }}"><i class="ri-arrow-left-line me-1"></i>Liste des clients</a>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="text-center">Rang</th>
              <th>Client</th>
              <th>Téléphone</th>
              <th class="text-end">Passages honorés</th>
              <th class="text-end">Total dépensé</th>
              <th class="text-end">Panier moyen</th>
              <th>Dernier passage</th>
              <th class="text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            {% for row in pagination %}
              <tr>
                <td class="text-center"><span class="badge {{ loop.index <= 3 and pagination.currentPageNumber == 1 ? 'bg-warning-subtle text-warning' : 'bg-light text-dark' }} fs-6">{{ ((pagination.currentPageNumber - 1) * pagination.itemNumberPerPage) + loop.index }}</span></td>
                <td class="fw-semibold">{{ row.client.nometprenom }}</td>
                <td>{{ row.client.telephone ?: '—' }}</td>
                <td class="text-end fw-semibold">{{ row.visits }}</td>
                <td class="text-end fw-bold text-success">{{ row.totalSpent|number_format(0, ',', ' ') }} MRU</td>
                <td class="text-end">{{ row.average|number_format(0, ',', ' ') }} MRU</td>
                <td>{{ row.lastVisit ? row.lastVisit|date('d/m/Y') : '—' }}</td>
                <td class="text-end"><a class="btn btn-sm btn-soft-info" href="{{ path('app_client_show', {id: row.client.id}) }}"><i class="ri-eye-line me-1"></i>Voir</a></td>
              </tr>
            {% else %}
              <tr><td colspan="8" class="text-center text-muted py-5"><i class="ri-user-search-line fs-1 d-block mb-2"></i>Aucun client ne correspond aux critères.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% if pagination.getTotalItemCount > pagination.itemNumberPerPage %}
      <div class="card-footer">{{ knp_pagination_render(pagination) }}</div>
    {% endif %}
  </div>
{% endblock %}
