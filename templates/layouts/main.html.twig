<!doctype html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="light" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable" data-theme="default" data-theme-colors="withe">
<head>
    <meta charset="utf-8" />
    <title>Fyracare | Gestion</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- App favicon -->
    <link rel="shortcut icon" href="{{ asset('assets/images/favicon.ico') }}">
    <link href="{{ asset('velzon/libs/jsvectormap/jsvectormap.min.css') }}" rel="stylesheet" />
    <link href="{{ asset('velzon/libs/swiper/swiper-bundle.min.css') }}" rel="stylesheet" />
     <script src="{{ asset('velzon/js/layout.js') }}"></script>
    <!-- Bootstrap Css -->
    <link href="{{ asset('velzon/css/bootstrap.min.css') }}" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="{{ asset('velzon/css/icons.min.css') }}" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="{{ asset('velzon/css/app.min.css') }}" rel="stylesheet" type="text/css" />
    <link href="{{ asset('velzon/css/custom.min.css') }}" rel="stylesheet" type="text/css" />
    <style>
        :root {
            --vz-font-family-primary: system-ui, -apple-system, "Segoe UI", sans-serif;
            --vz-font-family-secondary: system-ui, -apple-system, "Segoe UI", sans-serif;
        }
        body, button, input, select, textarea,
        h1, h2, h3, h4, h5, h6 {
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        }
    </style>
    
    <!-- Block pour styles additionnels -->
    {% block stylesheets %}{% endblock %}
</head>

<body>
    {% if app.environment == 'demo' %}
        <div class="alert alert-danger rounded-0 text-center fw-semibold mb-0" role="alert">
            ENVIRONNEMENT DE DÉMONSTRATION — toutes les informations affichées sont fictives
        </div>
    {% endif %}
    <div id="layout-wrapper">
        {% include 'partials/topbar.html.twig' %}
        {% include 'partials/sidebar.html.twig' %}
        
        <div class="vertical-overlay"></div>
        
        <div class="main-content">
            <div class="page-content">
                <div class="container-fluid">
                    {% block page_header %}{% endblock %}
                    <div class="row">
                        <div class="col-12">
                            {% include 'partials/flashes.html.twig' %}
                            {% block body %}{% endblock %}
                        </div>
                    </div>
                </div>
            </div>
            
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-6">
                            <script>document.write(new Date().getFullYear())</script> © Dantie-IT.
                        </div>
                        <div class="col-sm-6">
                            <div class="text-sm-end d-none d-sm-block">
                                Design & Develop by Amadou Adjanouhoun
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    {# Le thème Velzon attend ce composant même lorsque les notifications ne sont
       pas utilisées. Sa présence évite une erreur JavaScript globale. #}
    <div id="removeNotificationModal" class="d-none" aria-hidden="true">
        <button id="delete-notification" type="button"></button>
        <button id="NotificationModalbtn-close" type="button"></button>
    </div>

    <!-- Bibliothèques locales communes -->
    <script src="{{ asset('velzon/libs/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
    
    <script src="{{ asset('velzon/libs/simplebar/simplebar.min.js') }}"></script>
    <script src="{{ asset('velzon/libs/node-waves/waves.min.js') }}"></script>
    <script src="{{ asset('velzon/libs/feather-icons/feather.min.js') }}"></script>
    <script src="{{ asset('velzon/js/pages/plugins/lord-icon-2.1.0.js') }}"></script>
    
    <script src="{{ asset('velzon/libs/apexcharts/apexcharts.min.js') }}"></script>
    <script src="{{ asset('velzon/libs/jsvectormap/jsvectormap.min.js') }}"></script>
    <script src="{{ asset('velzon/libs/jsvectormap/maps/world-merc.js') }}"></script>
    <script src="{{ asset('velzon/libs/swiper/swiper-bundle.min.js') }}"></script>
    
    <script src="{{ asset('velzon/js/pages/dashboard-ecommerce.init.js') }}"></script>
    <script src="{{ asset('velzon/js/app.js') }}"></script>
    
    <!-- Scripts propres à chaque écran -->
    {% block javascripts %}{% endblock %}
</body>
</html>
