{% extends 'layouts/main.html.twig' %}
{% block title %}Statistiques{% endblock %}

{% block stylesheets %}
<style>
  .stats-filter { background: linear-gradient(135deg, #405189, #299cdb); color: #fff; }
  .stats-filter .form-label { color: rgba(255,255,255,.9); }
  .metric-card { border: 0; box-shadow: 0 .125rem .5rem rgba(0,0,0,.06); height: 100%; }
  .metric-card .metric-value { font-size: 1.65rem; font-weight: 700; }
  .stats-tabs .nav-link { font-weight: 600; }
  .stats-tabs .nav-link.active { color: var(--vz-primary); border-bottom: 3px solid var(--vz-primary); }
  .chart-box { min-height: 330px; }
  .stats-periods { overflow-x: auto; flex-wrap: nowrap !important; padding-bottom: .25rem; }
  .stats-periods .btn { white-space: nowrap; }
  .performance-table { min-width: 760px; }
  @media (max-width: 767.98px) {
    .chart-box { min-height: 280px; }
    .stats-tabs { flex-wrap: nowrap; overflow-x: auto; }
    .stats-tabs .nav-link { white-space: nowrap; }
    .page-title-box > .d-flex { margin-top: 1rem; width: 100%; }
    .page-title-box > .d-flex .btn { flex: 1; }
  }
  @media print {
    .stats-filter, .stats-tabs, .btn-print, .page-title-right { display: none !important; }
    .tab-pane { display: block !important; opacity: 1 !important; }
  }
</style>
{% endblock %}

{% block page_header %}
<div class="row">
  <div class="col-12">
    <div class="page-title-box d-sm-flex align-items-center justify-content-between">
      <div>
        <h4 class="mb-sm-0"><i class="ri-bar-chart-box-line me-2 text-primary"></i>Statistiques</h4>
        <p class="text-muted mb-0">Activité, finances et performances sur une période</p>
      </div>
      <div class="d-flex gap-2">
        <a href="{{ path('stats_index', {from: from|date('Y-m-d'), to: to|date('Y-m-d'), format: 'csv'}) }}"
           class="btn btn-soft-success">
          <i class="ri-file-excel-2-line me-1"></i> Exporter CSV
        </a>
        <button type="button" class="btn btn-soft-secondary btn-print" onclick="window.print()">
          <i class="ri-printer-line me-1"></i> Imprimer
        </button>
        <a href="{{ path('admin_dashboard') }}" class="btn btn-soft-primary">Dashboard</a>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block body %}
{% set totalFinal = kpis.honores + kpis.absents + kpis.annules %}
{% set tauxRealisation = kpis.rdv > 0 ? (kpis.honores / kpis.rdv * 100) : 0 %}
{% set tauxAbsence = kpis.rdv > 0 ? (kpis.absents / kpis.rdv * 100) : 0 %}
{% set tauxAnnulation = kpis.rdv > 0 ? (kpis.annules / kpis.rdv * 100) : 0 %}

<div class="card stats-filter border-0 shadow-sm mb-4">
  <div class="card-body">
    <form method="get" class="row g-3 align-items-end">
      <div class="col-lg-3 col-md-6">
        <label class="form-label">Date de début</label>
        <input type="date" class="form-control" name="from" value="{{ from|date('Y-m-d') }}" required>
      </div>
      <div class="col-lg-3 col-md-6">
        <label class="form-label">Date de fin</label>
        <input type="date" class="form-control" name="to" value="{{ to|date('Y-m-d') }}" required>
      </div>
      <div class="col-lg-3 col-md-6">
        <button class="btn btn-light w-100"><i class="ri-search-line me-1"></i> Analyser</button>
      </div>
      <div class="col-lg-3 col-md-6">
        <a class="btn btn-outline-light w-100" href="{{ path('stats_index') }}">
          <i class="ri-refresh-line me-1"></i> Mois en cours
        </a>
      </div>
    </form>
    <div class="mt-3 small text-white-50">
      Période analysée : {{ from|date('d/m/Y') }} → {{ to|date('d/m/Y') }}
      ({{ from.diff(to).days|abs + 1 }} jours)
    </div>
    <div class="d-flex gap-2 mt-3 stats-periods">
      {% set periods = {
        today: 'Aujourd’hui',
        week: 'Cette semaine',
        month: 'Ce mois',
        previous_month: 'Mois précédent',
        year: 'Cette année'
      } %}
      {% for key, label in periods %}
        <a href="{{ key == 'month' ? path('stats_index') : path('stats_index', {period: key}) }}"
           class="btn btn-sm {{ (key == 'month' and selectedPeriod == '') or selectedPeriod == key ? 'btn-light' : 'btn-outline-light' }}">
          {{ label }}
        </a>
      {% endfor %}
    </div>
  </div>
</div>

<div class="alert alert-info border-0">
  <i class="ri-information-line me-1"></i>
  Les résultats d’activité utilisent la date prévue du rendez-vous. Les encaissements utilisent la date du paiement.
</div>

<ul class="nav nav-tabs nav-tabs-custom stats-tabs mb-4" role="tablist">
  <li class="nav-item">
    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#stats-activity" type="button">
      <i class="ri-calendar-check-line me-1"></i> Activité
    </button>
  </li>
  <li class="nav-item">
    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#stats-finance" type="button">
      <i class="ri-money-dollar-circle-line me-1"></i> Finances
    </button>
  </li>
  <li class="nav-item">
    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#stats-services" type="button">
      <i class="ri-service-line me-1"></i> Prestations
    </button>
  </li>
</ul>

<div class="tab-content">
  <div class="tab-pane fade show active" id="stats-activity">
    <div class="row g-3 mb-4">
      {% set activityCards = [
        {label: 'Total RDV', value: kpis.rdv, color: 'primary', icon: 'ri-calendar-2-line'},
        {label: 'Honorés', value: kpis.honores, color: 'success', icon: 'ri-checkbox-circle-line'},
        {label: 'Absents', value: kpis.absents, color: 'secondary', icon: 'ri-user-unfollow-line'},
        {label: 'Annulés', value: kpis.annules, color: 'danger', icon: 'ri-close-circle-line'}
      ] %}
      {% for card in activityCards %}
        <div class="col-xl-3 col-sm-6">
          <div class="card metric-card">
            <div class="card-body d-flex justify-content-between align-items-center">
              <div>
                <p class="text-muted mb-1">{{ card.label }}</p>
                <div class="metric-value text-{{ card.color }}">{{ card.value|number_format(0, ',', ' ') }}</div>
              </div>
              <span class="avatar-title bg-{{ card.color }}-subtle text-{{ card.color }} rounded fs-2 p-3">
                <i class="{{ card.icon }}"></i>
              </span>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="card metric-card"><div class="card-body text-center">
          <p class="text-muted mb-1">Taux de réalisation</p>
          <div class="metric-value text-success">{{ tauxRealisation|round(1) }} %</div>
        </div></div>
      </div>
      <div class="col-md-4">
        <div class="card metric-card"><div class="card-body text-center">
          <p class="text-muted mb-1">Taux d’absence</p>
          <div class="metric-value text-secondary">{{ tauxAbsence|round(1) }} %</div>
        </div></div>
      </div>
      <div class="col-md-4">
        <div class="card metric-card"><div class="card-body text-center">
          <p class="text-muted mb-1">Taux d’annulation</p>
          <div class="metric-value text-danger">{{ tauxAnnulation|round(1) }} %</div>
        </div></div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h5 class="card-title mb-0">Évolution des rendez-vous</h5></div>
      <div class="card-body"><div id="chart-activity" class="chart-box"></div></div>
    </div>
  </div>

  <div class="tab-pane fade" id="stats-finance">
    <div class="row g-3 mb-4">
      {% set financeCards = [
        {label: 'CA réalisé', value: kpis.ca, color: 'success'},
        {label: 'Encaissements reçus', value: kpis.encaissements, color: 'primary'},
        {label: 'Reste à encaisser', value: kpis.resteAEncaisser, color: 'warning'},
        {label: 'Dépenses', value: kpis.depenses, color: 'danger'}
      ] %}
      {% for card in financeCards %}
        <div class="col-xl-3 col-sm-6">
          <div class="card metric-card"><div class="card-body">
            <p class="text-muted mb-1">{{ card.label }}</p>
            <div class="metric-value text-{{ card.color }}">{{ card.value|number_format(0, ',', ' ') }} <small class="fs-13">MRU</small></div>
          </div></div>
        </div>
      {% endfor %}
    </div>

    <div class="row g-3 mb-4">
      <div class="col-xl-8">
        <div class="card h-100">
          <div class="card-header"><h5 class="card-title mb-0">CA réalisé et encaissements</h5></div>
          <div class="card-body"><div id="chart-finance" class="chart-box"></div></div>
        </div>
      </div>
      <div class="col-xl-4">
        <div class="card h-100">
          <div class="card-header"><h5 class="card-title mb-0">Modes d’encaissement</h5></div>
          <div class="card-body"><div id="chart-methods" class="chart-box"></div></div>
        </div>
      </div>
    </div>

    <div class="row g-3">
      <div class="col-xl-8">
        <div class="card">
          <div class="card-header"><h5 class="card-title mb-0">Dépenses par catégorie</h5></div>
          <div class="card-body"><div id="chart-expenses" class="chart-box"></div></div>
        </div>
      </div>
      <div class="col-xl-4">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title">Lecture de la caisse physique</h5>
            <div class="d-flex justify-content-between border-bottom py-3">
              <span>Espèces encaissées</span><strong>{{ kpis.especes|number_format(0, ',', ' ') }} MRU</strong>
            </div>
            <div class="d-flex justify-content-between border-bottom py-3">
              <span>Paiements mobiles</span><strong>{{ kpis.mobile|number_format(0, ',', ' ') }} MRU</strong>
            </div>
            <div class="d-flex justify-content-between py-3">
              <span>Flux net de caisse</span>
              <strong class="{{ kpis.fluxCaisse < 0 ? 'text-danger' : 'text-success' }}">
                {{ kpis.fluxCaisse|number_format(0, ',', ' ') }} MRU
              </strong>
            </div>
            <p class="text-muted small mb-0">Le mobile est inclus dans les encaissements, jamais dans la caisse physique.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tab-pane fade" id="stats-services">
    <div class="card">
      <div class="card-header">
        <h5 class="card-title mb-1">Performance des prestations honorées</h5>
        <p class="text-muted mb-0">Comparaison du volume, du chiffre d’affaires réalisé et des paiements reçus.</p>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 performance-table">
            <thead class="table-light">
              <tr>
                <th>Prestation</th>
                <th class="text-end">Réalisées</th>
                <th class="text-end">CA réalisé</th>
                <th class="text-end">Encaissé</th>
                <th class="text-end">Écart</th>
              </tr>
            </thead>
            <tbody>
              {% for row in performances %}
                <tr>
                  <td class="fw-medium">{{ row.libelle }}</td>
                  <td class="text-end">{{ row.count }}</td>
                  <td class="text-end">{{ row.ca|number_format(0, ',', ' ') }} MRU</td>
                  <td class="text-end">{{ row.encaisse|number_format(0, ',', ' ') }} MRU</td>
                  <td class="text-end {{ row.encaisse - row.ca < 0 ? 'text-warning' : 'text-success' }}">
                    {{ (row.encaisse - row.ca)|number_format(0, ',', ' ') }} MRU
                  </td>
                </tr>
              {% else %}
                <tr><td colspan="5" class="text-center text-muted py-5">Aucune prestation honorée sur cette période.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
  const labels = {{ labels|json_encode|raw }};
  const money = value => Intl.NumberFormat('fr-FR').format(value) + ' MRU';
  const colors = names => names.map(name => getComputedStyle(document.documentElement).getPropertyValue(name).trim() || name);

  const activityChart = new ApexCharts(document.querySelector('#chart-activity'), {
    chart: { type: 'line', height: 330, toolbar: { show: false } },
    series: [
      { name: 'Honorés', data: {{ honoredValues|json_encode|raw }} },
      { name: 'Absents', data: {{ absentValues|json_encode|raw }} },
      { name: 'Annulés', data: {{ cancelledValues|json_encode|raw }} }
    ],
    xaxis: { categories: labels },
    stroke: { curve: 'smooth', width: 3 },
    colors: colors(['--vz-success', '--vz-secondary', '--vz-danger']),
    noData: { text: 'Aucune donnée' }
  });
  activityChart.render();

  let financeRendered = false;
  const renderFinanceCharts = () => {
    if (financeRendered) return;
    financeRendered = true;

    new ApexCharts(document.querySelector('#chart-finance'), {
      chart: { type: 'area', height: 330, toolbar: { show: false } },
      series: [
        { name: 'CA réalisé', data: {{ revenueValues|json_encode|raw }} },
        { name: 'Encaissements', data: {{ receiptsValues|json_encode|raw }} }
      ],
      xaxis: { categories: labels },
      stroke: { curve: 'smooth', width: 3 },
      colors: colors(['--vz-success', '--vz-primary']),
      yaxis: { labels: { formatter: money } },
      tooltip: { y: { formatter: money } }
    }).render();

    new ApexCharts(document.querySelector('#chart-methods'), {
      chart: { type: 'donut', height: 330 },
      labels: ['Espèces', 'Mobile'],
      series: [{{ kpis.especes }}, {{ kpis.mobile }}],
      colors: colors(['--vz-success', '--vz-info']),
      legend: { position: 'bottom' },
      tooltip: { y: { formatter: money } },
      noData: { text: 'Aucun encaissement' }
    }).render();

    new ApexCharts(document.querySelector('#chart-expenses'), {
      chart: { type: 'bar', height: 330, toolbar: { show: false } },
      series: [{ name: 'Dépenses', data: {{ expensesByCategory|map(row => row.total)|json_encode|raw }} }],
      xaxis: { categories: {{ expensesByCategory|map(row => row.name)|json_encode|raw }} },
      colors: colors(['--vz-danger']),
      plotOptions: { bar: { borderRadius: 5, horizontal: true } },
      tooltip: { y: { formatter: money } },
      noData: { text: 'Aucune dépense' }
    }).render();
  };

  document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => {
    tab.addEventListener('shown.bs.tab', event => {
      const target = event.target.getAttribute('data-bs-target');
      if (target === '#stats-finance') renderFinanceCharts();
      if (target) history.replaceState(null, '', target);
    });
  });

  const requestedTab = ['#stats-activity', '#stats-finance', '#stats-services'].includes(location.hash)
    ? document.querySelector(`[data-bs-target="${location.hash}"]`)
    : null;
  if (requestedTab) {
    bootstrap.Tab.getOrCreateInstance(requestedTab).show();
  }
});
</script>
{% endblock %}
