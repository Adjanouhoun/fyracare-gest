{% extends 'layouts/main.html.twig' %}
{% block title %}Nouvelle dépense{% endblock %}

{% block page_header %}
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
      <h4 class="fs-16 mb-1">Nouvelle dépense</h4>
      <p class="text-muted mb-0">
        Solde disponible aujourd’hui :
        <strong>{{ availableToday|number_format(0, ',', ' ') }} MRU</strong>
      </p>
    </div>
    <a href="{{ path('cash_index') }}" class="btn btn-ghost-secondary">
      <i class="ri-arrow-left-line me-1"></i> Retour à la caisse
    </a>
  </div>
{% endblock %}

{% block body %}
  <div class="card">
    <div class="card-body">
      <div class="alert alert-warning">
        Une dépense validée ne se modifie pas. En cas d’erreur, elle devra être annulée par un administrateur afin de préserver la traçabilité.
      </div>

      {{ form_start(form, {attr: {id: 'cash-expense-form'}}) }}
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Montant (MRU)</label>
            {{ form_widget(form.amount, {attr:{
              class:'form-control',
              min:1,
              max:availableToday,
              inputmode:'numeric'
            }}) }}
            {{ form_errors(form.amount) }}
            <div class="form-text">
              Maximum disponible : {{ availableToday|number_format(0, ',', ' ') }} MRU
            </div>
          </div>

          <div class="col-md-4">
            <label class="form-label">Catégorie</label>
            {{ form_widget(form.category, {attr:{class:'form-select'}}) }}
            {{ form_errors(form.category) }}
          </div>

          <div class="col-md-8">
            <label class="form-label">Motif / Notes</label>
            {{ form_widget(form.notes, {attr:{
              class:'form-control',
              rows:3,
              placeholder:'Précisez la nature de la dépense'
            }}) }}
            {{ form_errors(form.notes) }}
          </div>
        </div>

        <div class="mt-4 d-flex flex-column flex-sm-row gap-2">
          <button class="btn btn-danger" type="submit">
            <i class="ri-check-line"></i> Enregistrer la dépense
          </button>
          <a href="{{ path('cash_index') }}" class="btn btn-ghost-secondary">Annuler</a>
        </div>
      {{ form_end(form) }}
    </div>
  </div>

  <script>
    document.getElementById('cash-expense-form')?.addEventListener('submit', function (event) {
      const amount = document.getElementById('{{ form.amount.vars.id }}')?.value || '0';
      if (!window.confirm('Confirmer l’enregistrement définitif de cette dépense de ' + amount + ' MRU ?')) {
        event.preventDefault();
      }
    });
  </script>
{% endblock %}
