{% extends 'layouts/main.html.twig' %}
{% block title %}Utilisateurs
{% endblock %}

{% block page_header %}
	<div class="row">
		<div class="col-12">
			<div class="page-title-box d-sm-flex align-items-center justify-content-between">
				<div>
					<h4 class="mb-sm-0">
						<i class="ri-user-line"></i>
						Gestion des utilisateurs
					</h4>
					<p class="text-muted mb-0">Voir - Modifier - Activer ou désactiver</p>
				</div>
				<div class="page-title-right">
					<ol class="breadcrumb m-0">
						<li class="breadcrumb-item">
							<a href="{{ path('admin_dashboard') }}">Dashboard</a>
						</li>
						<li class="breadcrumb-item active">Utilisateurs</li>
					</ol>
				</div>
			</div>
		</div>
	</div>
	<div class="card">
		<div class="card-body">
			<div class="row mb-3 pb-1">
				<div class="d-flex align-items-center justify-content-between">
					<div>
						<h4 class="fs-16 mb-1">Utilisateurs</h4>
						<p class="text-muted mb-0">Gestion des comptes</p>
					</div>
					<a class="btn btn-primary" href="{{ path('app_user_new') }}">
						<i class="ri-user-add-line align-middle me-1"></i>
						Nouvel utilisateur
					</a>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block body %}
	{% include 'partials/flashes.html.twig' %}

	<div class="card">
		<div class="card-body">
			<div class="table-responsive table-card">
				<table class="table align-middle table-hover">
					<thead class="table-light">
						<tr>
							<th>Nom</th>
							<th>Email</th>
							<th>Fonction</th>
							<th>Rôles</th>
							<th>État</th>
							<th class="text-end">Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for u in users %}
							<tr>
								<td>{{ u.fullname }}</td>
								<td>{{ u.email }}</td>
								<td>{{ u.fonction ?: '—' }}</td>
								<td>
									{% for r in u.roles %}
										<span class="badge bg-secondary-subtle text-secondary">{{ r }}</span>
									{% endfor %}
								</td>
								<td>
									<span class="badge {{ u.active ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' }}">
										{{ u.active ? 'Actif' : 'Désactivé' }}
									</span>
								</td>
								<td class="text-end">
									<div class="btn-group">
										<a class="btn btn-sm btn-soft-secondary" href="{{ path('app_user_show', {id: u.id}) }}">
											<i class="ri-eye-line"></i>
										</a>
										<a class="btn btn-sm btn-soft-info" href="{{ path('app_user_edit', {id: u.id}) }}">
											<i class="ri-pencil-line"></i>
										</a>
										{% if u.active %}
										<form method="post" action="{{ path('app_user_deactivate', {id: u.id}) }}" onsubmit="return confirm('Désactiver ce compte ? Il ne pourra plus se connecter.');" class="d-inline">
											<input type="hidden" name="_token" value="{{ csrf_token('deactivate_user_' ~ u.id) }}">
											<button class="btn btn-sm btn-soft-danger">
												<i class="ri-user-unfollow-line"></i>
											</button>
										</form>
										{% else %}
										<form method="post" action="{{ path('app_user_reactivate', {id: u.id}) }}" class="d-inline">
											<input type="hidden" name="_token" value="{{ csrf_token('reactivate_user_' ~ u.id) }}">
											<button class="btn btn-sm btn-soft-success"><i class="ri-user-follow-line"></i></button>
										</form>
										{% endif %}
									</div>
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="6" class="text-center text-muted">Aucun utilisateur.</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	</div>
{% endblock %}
