{% extends 'layouts/main.html.twig' %}
{% block title %}Annulation du rendez-vous{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-warning">
            <div class="card-header bg-warning-subtle">
                <h4 class="mb-0"><i class="ri-calendar-close-line"></i> Annuler le rendez-vous</h4>
            </div>
            <div class="card-body">
                {% if rdv.cancelled %}
                    <div class="alert alert-info mb-0">
                        Ce rendez-vous est déjà annulé le {{ rdv.cancelledAt|date('d/m/Y H:i') }}.
                        <br><strong>Motif :</strong> {{ rdv.cancellationReason }}
                    </div>
                {% else %}
                    <p>
                        Le rendez-vous de <strong>{{ rdv.client.nometprenom }}</strong>,
                        prévu le <strong>{{ rdv.startAt|date('d/m/Y H:i') }}</strong>, sera marqué comme annulé.
                    </p>
                    <div class="alert alert-info">
                        Aucun rendez-vous, paiement ou mouvement de caisse ne sera supprimé.
                        Les paiements doivent être annulés séparément si un remboursement ou une correction est nécessaire.
                    </div>
                    <form method="post" action="{{ path('app_rdv_cancel', {id: rdv.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_rdv_' ~ rdv.id) }}">
                        <label for="rdv-cancellation-reason" class="form-label">Motif obligatoire</label>
                        <textarea id="rdv-cancellation-reason" name="reason" class="form-control mb-3" minlength="5" maxlength="1000" required></textarea>
                        <button type="submit" class="btn btn-warning" onclick="return confirm('Confirmer l’annulation de ce rendez-vous ?');">
                            Confirmer l’annulation
                        </button>
                        <a href="{{ path('app_rdv_show', {id: rdv.id}) }}" class="btn btn-secondary">Retour</a>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
