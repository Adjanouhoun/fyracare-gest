{% extends 'layouts/main.html.twig' %}

{% block title %}Modifier le rendez-vous{% endblock %}

{% block page_header %}
  <div class="d-flex align-items-center justify-content-between">
    <div>
      <h4 class="fs-16 mb-1">Modifier le rendez-vous</h4>
      <p class="text-muted mb-0">
        {{ rdv.startAt ? rdv.startAt|date('d/m/Y à H:i') : 'Date à définir' }}
      </p>
    </div>
    <a href="{{ path('app_rdv_show', {id: rdv.id}) }}" class="btn btn-ghost-secondary">
      <i class="ri-arrow-left-line"></i> Retour au rendez-vous
    </a>
  </div>
{% endblock %}

{% block body %}
  <div class="card">
    <div class="card-body">
      {% include 'rdv/_form.html.twig' with {
        form: form,
        button_label: 'Enregistrer les modifications',
        allow_client_search: false
      } only %}
    </div>
  </div>
{% endblock %}
