{% extends 'layouts/main.html.twig' %}
{% block title %}Mon profil{% endblock %}

{% block page_header %}
  <div class="d-flex align-items-center justify-content-between">
    <div>
      <h4 class="fs-16 mb-1">Mon profil</h4>
      <p class="text-muted mb-0">Consultation de mon compte</p>
    </div>
    <a href="{{ path('admin_dashboard') }}" class="btn btn-ghost-secondary">
      <i class="ri-arrow-left-line align-middle me-1"></i> Retour
    </a>
  </div>
{% endblock %}

{% block body %}
  <div class="card">
    <div class="card-body">
      <div class="alert alert-info">
        <i class="ri-information-line me-1"></i>
        Ces informations sont en lecture seule. Seul un administrateur peut modifier un compte.
      </div>
      <dl class="row mb-0">
        <dt class="col-sm-3">Nom complet</dt>
        <dd class="col-sm-9">{{ user.fullname }}</dd>

        <dt class="col-sm-3">E-mail</dt>
        <dd class="col-sm-9">{{ user.email }}</dd>

        <dt class="col-sm-3">Fonction</dt>
        <dd class="col-sm-9">{{ user.fonction ?: '—' }}</dd>

        <dt class="col-sm-3">État du compte</dt>
        <dd class="col-sm-9">
          <span class="badge {{ user.active ? 'bg-success' : 'bg-danger' }}">
            {{ user.active ? 'Actif' : 'Désactivé' }}
          </span>
        </dd>

        <dt class="col-sm-3">Profil d’accès</dt>
        <dd class="col-sm-9">
          {% if 'ROLE_SUPER_ADMIN' in user.roles %}
            Super administrateur
          {% elseif 'ROLE_ADMIN' in user.roles %}
            Administrateur
          {% elseif 'ROLE_MANAGER' in user.roles %}
            Manager
          {% elseif 'ROLE_RECEPTION_CAISSE' in user.roles %}
            Réception + Caisse
          {% else %}
            Utilisateur
          {% endif %}
        </dd>
      </dl>
    </div>
  </div>
{% endblock %}
