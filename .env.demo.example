# Copier ce fichier vers .env.local uniquement dans l'installation de démonstration.
# Ne jamais utiliser les secrets ou identifiants de la production.
APP_ENV=demo
APP_DEBUG=0
APP_SECRET=change-me-with-a-dedicated-random-demo-secret
DATABASE_URL="sqlite:///%kernel.project_dir%/var/demo/fyracare-demo.sqlite"
MAILER_DSN=null://null

APP_INACTIVITY_SECONDS=900
APP_INACTIVITY_WARNING=60
APP_INACTIVITY_ENABLED=true
APP_INACTIVITY_LOGOUT_MODE=false
